// Shared build settings for The Foundry.
// Personal signing lives in Signing.local.xcconfig (gitignored). Copy the .example file to start.

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Capability switches. YES or NO. Override in Signing.local.xcconfig.
FOUNDRY_CLOUDKIT = NO
FOUNDRY_HEALTHKIT = YES

#include? "Signing.local.xcconfig"

// Entitlement files are picked from the switches above so every combination builds.
FOUNDRY_IOS_ENTITLEMENTS = Config/Entitlements/iOS-HK$(FOUNDRY_HEALTHKIT)-CK$(FOUNDRY_CLOUDKIT).entitlements
FOUNDRY_MAC_ENTITLEMENTS = Config/Entitlements/macOS-CK$(FOUNDRY_CLOUDKIT).entitlements

// With no team, sign to run locally (simulator and this Mac).
FOUNDRY_SIGN_IDENTITY_ = -
CODE_SIGN_IDENTITY[sdk=macosx*] = $(FOUNDRY_SIGN_IDENTITY_$(DEVELOPMENT_TEAM):default=Apple Development)

PRODUCT_BUNDLE_IDENTIFIER = com.nicholas6719.foundry
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
DEVELOPMENT_LANGUAGE = en
